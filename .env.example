# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Auth
AUTH_SECRET=your_auth_secret_here

# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Email delivery for password recovery and reservation updates (Brevo free plan)
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=your-verified-gmail@example.com
BREVO_SENDER_NAME=DLS BARBER

# Alternative email delivery (Resend, requires a verified domain)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=DLS BARBER <no-reply@your-verified-domain.example>

# Optional: set during deploy
# VERCEL_TOKEN=
# NEON variables if used
