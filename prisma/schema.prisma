generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  nombre        String
  email         String   @unique
  password      String
  rol           Role     @default(CLIENTE)
  reservas      Reserva[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Barber {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  reservas    Reserva[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Float
  duracion    Int
  reservas    Reserva[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Reserva {
  id         String        @id @default(cuid())
  fecha      DateTime
  hora       String
  estado     EstadoReserva @default(PENDIENTE)
  usuarioId  String
  barberId   String
  serviceId  String
  usuario    User          @relation(fields: [usuarioId], references: [id])
  barber     Barber        @relation(fields: [barberId], references: [id])
  service    Service       @relation(fields: [serviceId], references: [id])

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

enum Role {
  ADMIN
  BARBERO
  CLIENTE
}

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  FINALIZADA
}